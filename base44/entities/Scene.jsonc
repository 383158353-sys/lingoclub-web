{
  "name": "Scene",
  "type": "object",
  "properties": {
    "movie_id": {
      "type": "string",
      "title": "\u5f71\u89c6ID"
    },
    "episode_id": {
      "type": "string",
      "title": "\u5267\u96c6ID"
    },
    "timestamp": {
      "type": "string",
      "title": "\u65f6\u95f4\u8282\u70b9"
    },
    "title": {
      "type": "string",
      "title": "\u573a\u666f\u6807\u9898"
    },
    "description": {
      "type": "string",
      "title": "\u573a\u666f\u63cf\u8ff0"
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "title": "\u573a\u666f\u56fe"
    },
    "order": {
      "type": "number",
      "title": "\u6392\u5e8f"
    },
    "ai_summary": {
      "type": "string",
      "title": "AI\u573a\u666f\u6458\u8981"
    }
  },
  "required": [
    "episode_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}