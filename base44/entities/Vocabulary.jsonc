{
  "name": "Vocabulary",
  "type": "object",
  "properties": {
    "expression_en": {
      "type": "string",
      "title": "\u82f1\u6587\u8868\u8fbe"
    },
    "meaning_zh": {
      "type": "string",
      "title": "\u4e2d\u6587\u89e3\u91ca"
    },
    "type": {
      "type": "string",
      "enum": [
        "word",
        "phrase",
        "sentence"
      ],
      "title": "\u7c7b\u578b",
      "default": "phrase"
    },
    "tag": {
      "type": "string",
      "title": "\u5b66\u4e60\u6807\u7b7e"
    },
    "source_movie_id": {
      "type": "string",
      "title": "\u6765\u6e90\u5f71\u89c6ID"
    },
    "source_movie_title": {
      "type": "string",
      "title": "\u6765\u6e90\u5f71\u89c6"
    },
    "source_scene_id": {
      "type": "string",
      "title": "\u6765\u6e90\u573a\u666fID"
    },
    "source_subtitle_id": {
      "type": "string",
      "title": "\u6765\u6e90\u53f0\u8bcdID"
    },
    "timestamp": {
      "type": "string",
      "title": "\u51fa\u73b0\u65f6\u95f4"
    },
    "mastery_level": {
      "type": "string",
      "enum": [
        "new",
        "learning",
        "familiar",
        "mastered"
      ],
      "title": "\u638c\u63e1\u5ea6",
      "default": "new"
    },
    "stage": {
      "type": "number",
      "title": "\u590d\u4e60\u9636\u6bb5",
      "default": 0,
      "description": "\u827e\u5bbe\u6d69\u65af 5 \u9636\u6bb5\uff1a0 \u65b0\u8bcd(\u5f53\u5929) / 1 \u4e00\u8f6e(1\u5929) / 2 \u4e8c\u8f6e(2\u5929) / 3 \u4e09\u8f6e(4\u5929) / 4 \u56db\u8f6e(7\u5929) / 5 \u957f\u671f\u8bb0\u5fc6(15\u5929+)\u3002\u7b54\u5bf9\u5347\u4e00\u7ea7\uff0c\u7b54\u9519\u91cd\u7f6e\u56de 0\u3002"
    },
    "review_count": {
      "type": "number",
      "title": "\u590d\u4e60\u6b21\u6570",
      "default": 0
    },
    "correct_count": {
      "type": "number",
      "title": "\u7b54\u5bf9\u6b21\u6570",
      "default": 0
    },
    "error_count": {
      "type": "number",
      "title": "\u7b54\u9519\u6b21\u6570",
      "default": 0
    },
    "review_history": {
      "type": "array",
      "title": "\u590d\u4e60\u5386\u53f2",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "\u6bcf\u6b21\u590d\u4e60\u7684 {date, result} \u8bb0\u5f55\uff0c\u622a\u65ad\u4fdd\u7559\u6700\u8fd1 50 \u6761\uff0c\u7528\u4e8e\u8ffd\u8e2a\u590d\u4e60\u8f6e\u6b21\u4e0e\u5bf9\u9519\u3002"
    },
    "ease_factor": {
      "type": "number",
      "title": "\u96be\u5ea6\u7cfb\u6570",
      "default": 2.5
    },
    "interval_days": {
      "type": "number",
      "title": "\u95f4\u9694\u5929\u6570",
      "default": 0
    },
    "last_reviewed_date": {
      "type": "string",
      "title": "\u4e0a\u6b21\u590d\u4e60\u65e5\u671f"
    },
    "next_review_date": {
      "type": "string",
      "title": "\u4e0b\u6b21\u590d\u4e60\u65e5\u671f"
    },
    "notes": {
      "type": "string",
      "title": "\u5907\u6ce8"
    },
    "profile": {
      "type": "object",
      "title": "\u5355\u8bcd\u753b\u50cf",
      "additionalProperties": true,
      "description": "\u7531 vocab-profile \u540e\u7aef\u51fd\u6570\u751f\u6210\u7684\u7ed3\u6784\u5316 LLM \u89e3\u6790\uff1a\u8bcd\u4e49/\u8bcd\u6839/\u4f8b\u53e5/\u540c\u6839\u8bcd/\u540c\u4e49\u66ff\u6362/\u52a9\u8bb0\u3002\u4f5c\u4e3a\u7f13\u5b58\u6301\u4e45\u5316\uff0c\u907f\u514d\u91cd\u590d\u8c03\u7528 LLM\u3002"
    },
    "audio_url": {
      "type": "string",
      "title": "\u53d1\u97f3\u7f13\u5b58URL",
      "description": "vocab-tts \u670d\u52a1\u7aef\u5408\u6210\u7684 MP3 \u94fe\u63a5,\u9996\u6b21\u64ad\u653e\u540e\u7f13\u5b58\u5230\u672c\u5361,\u907f\u514d\u91cd\u590d\u6d88\u8017 TTS \u79ef\u5206\u3002"
    }
  },
  "required": [
    "expression_en"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
