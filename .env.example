# Browser-visible configuration (these are public identifiers, not secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# Optional: fixed public hostname for the local Cloudflare Tunnel (hostname only, no scheme).
LINGOCLUB_DEV_HOST=

# Server-only values required by /api/ai and /api/ai-credentials.
# Keep these out of VITE_* variables and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
AI_CREDENTIALS_MASTER_KEY=

# Server-side AI configuration. Never put real credentials in this template.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=
AI_PROVIDER=

# Optional standalone transcript service. Token is server-side only.
TRANSCRIPT_SERVICE_URL=
TRANSCRIPT_SERVICE_TOKEN=
TRANSCRIPT_SERVICE_ALLOWED_ORIGINS=http://localhost:5173

# Server-only: daily recommendations import (/api/recommendations/import).
RECOMMENDATIONS_IMPORT_TOKEN=
# Supabase Auth user id (UUID) that receives the imported recommendations.
RECOMMENDATIONS_IMPORT_USER_ID=

# Server-only, recommended on Vercel: YouTube transcripts via Supadata
# (https://supadata.ai, free plan 100 requests/month). Vercel's IPs get
# YouTube's bot challenge; Supadata is tried first when this is set.
SUPADATA_API_KEY=
